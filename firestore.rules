rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        getUserData().role == 'admin'
      );
    }

    function getBusiness(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && getBusiness(businessId).ownerId == request.auth.uid;
    }

    function isBusinessApproved(businessId) {
      return getBusiness(businessId).status == 'approved';
    }

    // ------------------------------------------------------------------------
    // User Profiles Collection: /users/{userId}
    // ------------------------------------------------------------------------
    match /users/{userId} {
      // Allow user to read their own profile, or admins to read all profiles
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      // Create profile: User can only create their own document, role must be 'customer' or 'owner' (no admin creation)
      allow create: if isOwner(userId)
        && request.resource.data.role in ['customer', 'owner']
        && request.resource.data.email is string
        && request.resource.data.fullName is string;

      // Update profile: User can update their own doc, but CANNOT alter their role or email
      allow update: if (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email
      ) || isAdmin();

      // Deletion allowed by owner or admin
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ------------------------------------------------------------------------
    // Username Registry Collection: /usernames/{normalizedNickname}
    // ------------------------------------------------------------------------
    match /usernames/{normalizedNickname} {
      // Publicly readable for nickname availability checks
      allow read: if isSignedIn();

      // Creation only allowed if the UID matches request.auth.uid and document does not exist yet
      // Also verifies corresponding users/{uid} document matches normalizedNickname
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(normalizedNickname))
        && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedNickname == normalizedNickname) ||
          (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedNickname == normalizedNickname)
        );

      // Usernames are immutable once registered; deleted only when account is removed
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ------------------------------------------------------------------------
    // Businesses Collection: /businesses/{businessId}
    // ------------------------------------------------------------------------
    match /businesses/{businessId} {
      // Read: Any signed in user can read approved businesses; owner or admin can read pending/suspended
      allow read: if isSignedIn() && (
        resource.data.status == 'approved' ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );

      // Create: Owner can create their business, MUST start with 'pending' status
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string;

      // Update: Owner can update business info, but CANNOT change status (no self-approval) and cannot transfer ownerId
      // Only admin can change status (e.g. approve/reject)
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid &&
         request.resource.data.ownerId == resource.data.ownerId &&
         request.resource.data.status == resource.data.status) ||
        isAdmin()
      );

      // Delete: Only admin
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // Products Collection: /products/{productId}
    // ------------------------------------------------------------------------
    match /products/{productId} {
      // Read: Customers can read products from approved businesses.
      // Business owner can read products of their own business (even if pending).
      // Admin can read all products.
      allow read: if isSignedIn() && (
        isBusinessApproved(resource.data.businessId) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      // Create: Only the owner of the business (or admin) can create products.
      // costPrice is NEVER stored in the public product doc. Price must be positive int.
      allow create: if isSignedIn() && (
        isBusinessOwner(request.resource.data.businessId) ||
        isAdmin()
      ) && !('costPrice' in request.resource.data)
        && request.resource.data.price is int
        && request.resource.data.price >= 0;

      // Update & Delete: Only the owner of that business (or admin) can update/delete products.
      // Cannot change businessId and cannot store costPrice in public doc.
      allow update: if isSignedIn() && (
        (isBusinessOwner(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId) ||
        isAdmin()
      ) && !('costPrice' in request.resource.data);

      allow delete: if isSignedIn() && (
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      // Private cost subcollection: products/{productId}/private/{docId}
      // Readable and writable ONLY by the business owner (or admin). Customer cannot read.
      match /private/{docId} {
        allow read, write: if isSignedIn() && (
          isBusinessOwner(get(/databases/$(database)/documents/products/$(productId)).data.businessId) ||
          isAdmin()
        );
      }
    }

    // ------------------------------------------------------------------------
    // Orders Collection: /orders/{orderId}
    // ------------------------------------------------------------------------
    match /orders/{orderId} {
      // Read: Customer can read their own orders; Business owner can read orders for their business; Admin can read all
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      // Create: Signed-in customer creates order for themselves with initial status 'pending' (or legacy 'new')
      // for an approved business
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status in ['pending', 'new']
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['unpaid', 'pending'])
        && isBusinessApproved(request.resource.data.businessId);

      // Update:
      // - Customer can ONLY change status pending/new -> cancelled (ownership immutable)
      // - Business owner can update order status and paymentStatus for their own business (customerId/businessId immutable)
      // - Admin can update any order
      allow update: if isSignedIn() && (
        (resource.data.customerId == request.auth.uid &&
         (resource.data.status in ['pending', 'new']) &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.businessId == resource.data.businessId) ||
        (isBusinessOwner(resource.data.businessId) &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.businessId == resource.data.businessId) ||
        isAdmin()
      );

      // Delete: Admin only
      allow delete: if isAdmin();

      // Order lines subcollection: orders/{orderId}/items/{itemId}
      match /items/{itemId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          isBusinessOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.businessId) ||
          isAdmin()
        );

        // Customer creates line item: unitPrice must match product sellingPrice
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid &&
          request.resource.data.unitPrice == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.price &&
          request.resource.data.qty > 0 && request.resource.data.qty <= 99
        );

        // When completing, the owner writes unitCost per item snapshot
        allow update: if isSignedIn() && (
          isBusinessOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.businessId) ||
          isAdmin()
        );

        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------------------
    // Expenses Collection: /expenses/{expenseId}
    // ------------------------------------------------------------------------
    match /expenses/{expenseId} {
      // Read: Business owner can read expenses of their own business; Admin can read all
      allow read: if isSignedIn() && (
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      // Create: Only the owner of that business (or admin) can create expenses. Amount must be positive int.
      allow create: if isSignedIn() && (
        isBusinessOwner(request.resource.data.businessId) ||
        isAdmin()
      ) && request.resource.data.amount is int && request.resource.data.amount >= 0;

      // Update: Owner can update their own business expenses; businessId is immutable
      allow update: if isSignedIn() && (
        (isBusinessOwner(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId) ||
        isAdmin()
      );

      // Delete: Owner or admin can delete
      allow delete: if isSignedIn() && (
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );
    }

    // ------------------------------------------------------------------------
    // Events / Analytics Collection: /events/{eventId}
    // ------------------------------------------------------------------------
    match /events/{eventId} {
      // Any signed in user can record view events for themselves
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['view_product', 'view_business'];

      // Read: signed-in users can read business views
      allow read: if isSignedIn();

      allow update, delete: if isAdmin();
    }
  }
}

