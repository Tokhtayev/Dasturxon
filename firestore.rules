rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && (
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        getUserData().role == 'admin'
      );
    }

    function getBusiness(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)).data;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn() && getBusiness(businessId).ownerId == request.auth.uid;
    }

    function isBusinessApproved(businessId) {
      return getBusiness(businessId).status == 'approved';
    }

    // ------------------------------------------------------------------------
    // User Profiles Collection: /users/{userId}
    // ------------------------------------------------------------------------
    match /users/{userId} {
      // Allow user to read their own profile, or admins to read all profiles
      allow read: if isSignedIn() && (isOwner(userId) || isAdmin());

      // Create profile: User can only create their own document, role must be 'customer' or 'owner' (no admin creation)
      allow create: if isOwner(userId)
        && request.resource.data.role in ['customer', 'owner']
        && request.resource.data.email is string
        && (!('email' in request.auth.token) || request.resource.data.email == request.auth.token.email)
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100;

      // Update profile: User can update their own doc, but CANNOT alter their role or email
      allow update: if (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() >= 2 &&
        request.resource.data.fullName.size() <= 100
      ) || isAdmin();

      // Deletion allowed by owner or admin
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ------------------------------------------------------------------------
    // Username Registry Collection: /usernames/{normalizedNickname}
    // ------------------------------------------------------------------------
    match /usernames/{normalizedNickname} {
      // Publicly readable for nickname availability checks
      allow read: if isSignedIn();

      // Creation only allowed if the UID matches request.auth.uid and document does not exist yet
      // Also verifies corresponding users/{uid} document matches normalizedNickname
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(normalizedNickname))
        && (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedNickname == normalizedNickname) ||
          (getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.normalizedNickname == normalizedNickname)
        );

      // Usernames are immutable once registered; deleted only when account is removed
      allow update: if false;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ------------------------------------------------------------------------
    // Businesses Collection: /businesses/{businessId}
    // ------------------------------------------------------------------------
    match /businesses/{businessId} {
      // Read: Any signed in user can read approved businesses; owner or admin can read pending/suspended
      allow read: if isSignedIn() && (
        resource.data.status == 'approved' ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );

      // Create: Verified owner (role == 'owner' or 'admin') can create their business with 'pending' status,
      // or Admin can create and verify a business directly for an owner after consultation
      allow create: if isSignedIn() && (
        (getUserData().role in ['owner', 'admin'] &&
         request.resource.data.ownerId == request.auth.uid &&
         request.resource.data.status == 'pending') ||
        (isAdmin() && request.resource.data.status in ['pending', 'approved'])
      )
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 100
        && (!('legalForm' in request.resource.data) || request.resource.data.legalForm in ['mchj', 'yatt']);

      // Update: Owner can update business info, CANNOT transfer ownerId or self-approve.
      // Rejected businesses may be resubmitted back to 'pending'.
      // Only admin can approve or reject.
      allow update: if isSignedIn() && (
        (resource.data.ownerId == request.auth.uid &&
         request.resource.data.ownerId == resource.data.ownerId &&
         (request.resource.data.status == resource.data.status ||
          (resource.data.status == 'rejected' && request.resource.data.status == 'pending'))) ||
        isAdmin()
      );

      // Delete: Only admin
      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // Products Collection: /products/{productId}
    // ------------------------------------------------------------------------
    match /products/{productId} {
      // Read: Customers can read products from approved businesses.
      // Business owner can read products of their own business (even if pending).
      // Admin can read all products.
      allow read: if isSignedIn() && (
        isBusinessApproved(resource.data.businessId) ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      // Create: Only the owner of the business (or admin) can create products.
      // costPrice is NEVER stored in the public product doc. Price must be positive int.
      allow create: if isSignedIn() && (
        isBusinessOwner(request.resource.data.businessId) ||
        isAdmin()
      ) && !('costPrice' in request.resource.data)
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && (!('imageUrl' in request.resource.data) ||
            (request.resource.data.imageUrl is string &&
             request.resource.data.imageUrl.size() <= 900000))
        && (!('stock' in request.resource.data) ||
            request.resource.data.stock == null ||
            (request.resource.data.stock is int && request.resource.data.stock >= 0))
        && (!('discountPercent' in request.resource.data) ||
            (request.resource.data.discountPercent is int &&
             request.resource.data.discountPercent >= 0 &&
             request.resource.data.discountPercent <= 90))
        && (!('wholesaleEnabled' in request.resource.data) ||
            request.resource.data.wholesaleEnabled == false ||
            (request.resource.data.wholesaleEnabled == true &&
             request.resource.data.wholesaleMinQty is int &&
             request.resource.data.wholesaleMinQty >= 2 &&
             request.resource.data.wholesaleMinQty <= 10000 &&
             request.resource.data.wholesalePrice is int &&
             request.resource.data.wholesalePrice > 0 &&
             request.resource.data.wholesalePrice < request.resource.data.price));

      // Update & Delete:
      // - Business owner or admin can update/delete products (businessId immutable, no costPrice, valid bounds).
      // - Customer checkout transaction may ONLY decrement stock via a verified matching pending order.
      allow update: if isSignedIn() && !('costPrice' in request.resource.data) && (
        (isBusinessOwner(resource.data.businessId) &&
         request.resource.data.businessId == resource.data.businessId &&
         (!('imageUrl' in request.resource.data) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 900000)) &&
         (!('price' in request.resource.data) || (request.resource.data.price is int && request.resource.data.price > 0)) &&
         (!('stock' in request.resource.data) || request.resource.data.stock == null || (request.resource.data.stock is int && request.resource.data.stock >= 0)) &&
         (!('discountPercent' in request.resource.data) || (request.resource.data.discountPercent is int && request.resource.data.discountPercent >= 0 && request.resource.data.discountPercent <= 90)) &&
         (!('wholesaleEnabled' in request.resource.data) ||
          request.resource.data.wholesaleEnabled == false ||
          (request.resource.data.wholesaleEnabled == true &&
           request.resource.data.wholesaleMinQty is int &&
           request.resource.data.wholesaleMinQty >= 2 &&
           request.resource.data.wholesaleMinQty <= 10000 &&
           request.resource.data.wholesalePrice is int &&
           request.resource.data.wholesalePrice > 0))) ||
        isAdmin() ||
        (
          isBusinessApproved(resource.data.businessId) &&
          resource.data.status in ['available', 'hot_ready'] &&
          resource.data.stock is int &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'status', 'lastCheckoutOrderId', 'updatedAt']) &&
          request.resource.data.lastCheckoutOrderId is string &&
          !exists(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)) &&
          getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.customerId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.businessId == resource.data.businessId &&
          getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.productId == productId &&
          getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.status in ['pending', 'new'] &&
          getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.quantity is int &&
          getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.quantity > 0 &&
          (
            (!('orderType' in getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data) ||
             getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.orderType != 'wholesale')
              ? getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.quantity <= 99
              : ('wholesaleEnabled' in resource.data &&
                 resource.data.wholesaleEnabled == true &&
                 'wholesaleMinQty' in resource.data &&
                 resource.data.wholesaleMinQty is int &&
                 getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.quantity >= resource.data.wholesaleMinQty &&
                 getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.quantity <= 10000)
          ) &&
          request.resource.data.stock == resource.data.stock - getAfter(/databases/$(database)/documents/orders/$(request.resource.data.lastCheckoutOrderId)).data.quantity &&
          request.resource.data.stock >= 0 &&
          ((request.resource.data.stock == 0 && request.resource.data.status == 'sold_out') ||
           (request.resource.data.stock > 0 && request.resource.data.status in ['available', 'hot_ready']))
        )
      );

      allow delete: if isSignedIn() && (
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      // Private cost subcollection: products/{productId}/private/{docId}
      // Readable and writable ONLY by the business owner (or admin). Customer cannot read.
      match /private/{docId} {
        allow read, write: if isSignedIn() && (
          isBusinessOwner(get(/databases/$(database)/documents/products/$(productId)).data.businessId) ||
          isAdmin()
        );
      }
    }

    // ------------------------------------------------------------------------
    // Orders Collection: /orders/{orderId}
    // ------------------------------------------------------------------------
    match /orders/{orderId} {
      // Read: Customer can read their own orders; Business owner can read orders for their business; Admin can read all
      allow read: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      // Create: Signed-in customer creates order for themselves with initial status 'pending' (or legacy 'new')
      // for an approved business with bounded quantity (1..99 retail, wholesaleMinQty..10000 wholesale) and >= 50% advance
      allow create: if isSignedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status in ['pending', 'new']
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && (
          ((!('orderType' in request.resource.data) || request.resource.data.orderType == 'retail') &&
           request.resource.data.quantity <= 99) ||
          (request.resource.data.orderType == 'wholesale' &&
           exists(/databases/$(database)/documents/products/$(request.resource.data.productId)) &&
           get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesaleEnabled == true &&
           get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesaleMinQty is int &&
           request.resource.data.quantity >= get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesaleMinQty &&
           request.resource.data.quantity <= 10000 &&
           get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesalePrice is int &&
           get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesalePrice > 0 &&
           (!('unitPrice' in request.resource.data) ||
            request.resource.data.unitPrice == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesalePrice))
        )
        && (!('totalPrice' in request.resource.data) || (request.resource.data.totalPrice is int && request.resource.data.totalPrice > 0))
        && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['unpaid', 'pending'])
        && (!('receiptUrl' in request.resource.data) || request.resource.data.receiptUrl == '')
        && (!('prepaymentPercent' in request.resource.data) || request.resource.data.prepaymentPercent == 50)
        && (!('prepaymentStatus' in request.resource.data) || request.resource.data.prepaymentStatus in ['awaiting_advance', 'advance_submitted'])
        && (!('prepaymentAmount' in request.resource.data) ||
            (request.resource.data.prepaymentAmount is int &&
             request.resource.data.prepaymentAmount > 0 &&
             (!('totalPrice' in request.resource.data) ||
              (request.resource.data.prepaymentAmount * 2 >= request.resource.data.totalPrice &&
               request.resource.data.prepaymentAmount <= request.resource.data.totalPrice))))
        && (!('advanceReceiptUrl' in request.resource.data) ||
            (request.resource.data.advanceReceiptUrl is string &&
             request.resource.data.advanceReceiptUrl.size() <= 900000 &&
             (request.resource.data.advanceReceiptUrl == '' || request.resource.data.prepaymentStatus == 'advance_submitted')))
        && isBusinessApproved(request.resource.data.businessId);

      // Update:
      // - Customer can ONLY cancel pending order OR attach 50% advance receipt (cannot self-approve advance_paid or paid)
      // - Business owner can verify advance payment (advance_paid), update order status, paymentStatus, and payment receipt
      // - Admin can update any order
      allow update: if isSignedIn() && (
        (resource.data.customerId == request.auth.uid &&
         (resource.data.status in ['pending', 'new']) &&
         request.resource.data.status == 'cancelled' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
        (resource.data.customerId == request.auth.uid &&
         (resource.data.status in ['pending', 'new', 'accepted']) &&
         (!('prepaymentStatus' in resource.data) || resource.data.prepaymentStatus in ['awaiting_advance', 'advance_submitted']) &&
         request.resource.data.prepaymentStatus == 'advance_submitted' &&
         request.resource.data.advanceReceiptUrl is string &&
         request.resource.data.advanceReceiptUrl.size() > 0 &&
         request.resource.data.advanceReceiptUrl.size() <= 900000 &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prepaymentStatus', 'advanceReceiptUrl', 'advanceUploadedAt', 'updatedAt'])) ||
        (isBusinessOwner(resource.data.businessId) &&
         request.resource.data.customerId == resource.data.customerId &&
         request.resource.data.businessId == resource.data.businessId &&
         (!('totalPrice' in resource.data) || request.resource.data.totalPrice == resource.data.totalPrice) &&
         (!('quantity' in resource.data) || request.resource.data.quantity == resource.data.quantity) &&
         (!('prepaymentAmount' in resource.data) || request.resource.data.prepaymentAmount == resource.data.prepaymentAmount) &&
         (!('receiptUrl' in request.resource.data) ||
          (request.resource.data.receiptUrl is string &&
           request.resource.data.receiptUrl.size() <= 900000 &&
           (request.resource.data.receiptUrl == '' || request.resource.data.paymentStatus == 'paid'))) &&
         (!('advanceReceiptUrl' in request.resource.data) ||
          (request.resource.data.advanceReceiptUrl is string &&
           request.resource.data.advanceReceiptUrl.size() <= 900000))) ||
        isAdmin()
      );

      // Delete: Admin only
      allow delete: if isAdmin();

      // Order lines subcollection: orders/{orderId}/items/{itemId}
      match /items/{itemId} {
        function expectedLineItemPrice(prod) {
          return ('discountPercent' in prod &&
                  prod.discountPercent is int &&
                  prod.discountPercent > 0 &&
                  prod.discountPercent <= 90 &&
                  (!('discountEndsAt' in prod) || prod.discountEndsAt == null || prod.discountEndsAt > request.time))
            ? (prod.price - int(math.floor((prod.price * prod.discountPercent) / 100.0)))
            : prod.price;
        }

        function parentOrderData() {
          return exists(/databases/$(database)/documents/orders/$(orderId))
            ? get(/databases/$(database)/documents/orders/$(orderId)).data
            : getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
        }

        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid ||
          isBusinessOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.businessId) ||
          isAdmin()
        );

        // Customer creates line item (standalone or inside checkout transaction):
        // retail enforces expectedLineItemPrice & qty 1..99; wholesale enforces wholesalePrice & wholesaleMinQty..10000
        allow create: if isSignedIn()
          && parentOrderData().customerId == request.auth.uid
          && request.resource.data.qty is int
          && request.resource.data.qty > 0
          && (
            (('orderType' in parentOrderData() && parentOrderData().orderType == 'wholesale') &&
             get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesaleEnabled == true &&
             request.resource.data.unitPrice == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesalePrice &&
             request.resource.data.qty >= get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.wholesaleMinQty &&
             request.resource.data.qty <= 10000) ||
            ((!('orderType' in parentOrderData()) || parentOrderData().orderType != 'wholesale') &&
             request.resource.data.unitPrice == expectedLineItemPrice(get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data) &&
             request.resource.data.qty <= 99)
          );

        // When completing, the owner writes unitCost per item snapshot
        allow update: if isSignedIn() && (
          isBusinessOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.businessId) ||
          isAdmin()
        );

        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------------------
    // Expenses Collection: /expenses/{expenseId}
    // ------------------------------------------------------------------------
    match /expenses/{expenseId} {
      // Read: Business owner can read expenses of their own business; Admin can read all
      allow read: if isSignedIn() && (
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );

      // Create: Only the owner of that business (or admin) can create expenses. Amount must be positive int.
      allow create: if isSignedIn() && (
        isBusinessOwner(request.resource.data.businessId) ||
        isAdmin()
      ) && request.resource.data.amount is int && request.resource.data.amount >= 0;

      // Update: Owner can update their own business expenses; businessId is immutable
      allow update: if isSignedIn() && (
        (isBusinessOwner(resource.data.businessId) && request.resource.data.businessId == resource.data.businessId) ||
        isAdmin()
      );

      // Delete: Owner or admin can delete
      allow delete: if isSignedIn() && (
        isBusinessOwner(resource.data.businessId) ||
        isAdmin()
      );
    }

    // ------------------------------------------------------------------------
    // Events / Analytics Collection: /events/{eventId}
    // ------------------------------------------------------------------------
    match /events/{eventId} {
      // Any signed in user can record view events for themselves
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['view_product', 'view_business'];

      // Read: signed-in users can read business views
      allow read: if isSignedIn();

      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // Owner Onboarding Inquiries: /ownerInquiries/{inquiryId}
    // ------------------------------------------------------------------------
    match /ownerInquiries/{inquiryId} {
      // Create: Business applicants can submit pre-registration or pending-gate inquiries to Admin
      allow create: if request.resource.data.status == 'waiting'
        && request.resource.data.legalForm in ['mchj', 'yatt']
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() >= 2
        && request.resource.data.ownerName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.phone.size() <= 30
        && (!('adminReply' in request.resource.data) || request.resource.data.adminReply == '')
        && (!('ownerUid' in request.resource.data) || (isSignedIn() && request.resource.data.ownerUid == request.auth.uid));

      // Read: Admin reads all inquiries; signed-in owner reads only their own inquiries (no anonymous PII leak)
      allow read: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);

      // Update & Delete: Admin records legalForm (MChJ/YaTT), businessType, address, activity/products summary, and replies
      allow update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------------
    // App Settings Collection: /appSettings/{settingId}
    // ------------------------------------------------------------------------
    match /appSettings/{settingId} {
      // Signed-in users need the validated Apps Script webhook endpoint for sign-in email notifications
      allow read: if isSignedIn();

      // Only Admin may store a validated Google Apps Script Web App URL
      allow create, update: if isAdmin()
        && settingId == 'notifications'
        && (!('emailWebhookUrl' in request.resource.data) ||
            request.resource.data.emailWebhookUrl == '' ||
            (request.resource.data.emailWebhookUrl is string &&
             request.resource.data.emailWebhookUrl.size() <= 300 &&
             request.resource.data.emailWebhookUrl.matches('^https://script\\.google\\.com/macros/s/[A-Za-z0-9_-]+/exec$')));

      allow delete: if isAdmin();
    }
  }
}

